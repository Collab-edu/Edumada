# Adresse de l'API Laravel (backend/). Sans elle, le site fonctionne en mode statique
# avec les fichiers de public/data/ (pas de connexion, de favoris ni d'espaces).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Back-office (dossier backoffice/) : établissements et administration.
NEXT_PUBLIC_BACKOFFICE_URL=http://localhost:5173
# Bouton « Se connecter avec Google » : identifiant client OAuth (le même que GOOGLE_CLIENT_ID de l'API). Vide = bouton masqué.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
